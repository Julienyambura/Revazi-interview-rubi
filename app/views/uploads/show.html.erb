<div class="container mx-auto px-4 py-8 max-w-6xl">
  <div class="bg-white rounded-lg shadow-lg p-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Generated Images</h1>
    <p class="text-gray-600 mb-8">Your AI-generated images are ready!</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <!-- Enhanced Product Photo -->
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-lg font-semibold text-gray-700 mb-3">Enhanced Product Photo</h3>
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
          <% if @generated_images && @generated_images[:enhanced_product] %>
            <img src="data:image/jpeg;base64,<%= @generated_images[:enhanced_product][:base64] %>" 
                 alt="Enhanced Product" 
                 class="w-full h-auto">
          <% else %>
            <div class="p-8 text-center text-gray-500">Image not available</div>
          <% end %>
        </div>
        <p class="text-sm text-gray-500 mt-2">Clean background, no wrinkles</p>
      </div>

      <!-- Model Wearing Clothing -->
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-lg font-semibold text-gray-700 mb-3">Model Wearing Clothing</h3>
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
          <% if @generated_images && @generated_images[:model_wearing] %>
            <img src="data:image/jpeg;base64,<%= @generated_images[:model_wearing][:base64] %>" 
                 alt="Model Wearing" 
                 class="w-full h-auto">
          <% else %>
            <div class="p-8 text-center text-gray-500">Image not available</div>
          <% end %>
        </div>
        <p class="text-sm text-gray-500 mt-2">Virtual try-on result</p>
      </div>

      <!-- Product Back View -->
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-lg font-semibold text-gray-700 mb-3">Product Back View</h3>
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
          <% if @generated_images && @generated_images[:product_back] %>
            <img src="data:image/jpeg;base64,<%= @generated_images[:product_back][:base64] %>" 
                 alt="Product Back" 
                 class="w-full h-auto">
          <% else %>
            <div class="p-8 text-center text-gray-500">Image not available</div>
          <% end %>
        </div>
        <p class="text-sm text-gray-500 mt-2">Back view of the product</p>
      </div>

      <!-- Model Wearing Back View -->
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-lg font-semibold text-gray-700 mb-3">Model Wearing Back View</h3>
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
          <% if @generated_images && @generated_images[:model_wearing_back] %>
            <img src="data:image/jpeg;base64,<%= @generated_images[:model_wearing_back][:base64] %>" 
                 alt="Model Wearing Back" 
                 class="w-full h-auto">
          <% else %>
            <div class="p-8 text-center text-gray-500">Image not available</div>
          <% end %>
        </div>
        <p class="text-sm text-gray-500 mt-2">Back view of virtual try-on</p>
      </div>
    </div>

    <div class="text-center">
      <%= link_to "Upload Another", root_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-lg transition-colors" %>
    </div>
  </div>
</div>

